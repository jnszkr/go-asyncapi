// duplicate returns the indexes of the first two equal items of s.
func duplicate[T comparable](s []T) (i, j int, ok bool) {
	seen := make(map[T]int, len(s))
	for j, v := range s {
		if i, ok := seen[v]; ok {
			return i, j, true
		}
		seen[v] = j
	}
	return 0, 0, false
}
