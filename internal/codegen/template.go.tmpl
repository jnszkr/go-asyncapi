func Terminate(err error) error { return &MalformedError{Err: err} }

// settle maps the error of a Consumer handler to a Settlement.
func settle(err error) (Settlement, error) {
	var m *MalformedError
	switch {
	case err == nil:
		return Ack, nil
	case errors.As(err, &m):
		return Term, err
	default:
		return Nak, err
	}
}
